# Copy to .env.local and fill in. Never commit .env.local.

# --- Convex (written by `npx convex dev` on first run) ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# --- Clerk (Clerk dashboard → API keys; use the same instance for both) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Set these in the Convex dashboard (Settings → Environment Variables) ---
# Convex functions read them there, not from this file. Listed here so the
# full set lives in one place.
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# CLERK_WEBHOOK_SECRET=whsec_...       (Clerk webhook → <NEXT_PUBLIC_CONVEX_SITE_URL>/clerk)
# Code runner (docs/notes/decisions.md §5). Vercel access token, team ID and
# the project ID that owns the sandboxes:
# VERCEL_TOKEN=...
# VERCEL_TEAM_ID=team_...
# VERCEL_PROJECT_ID=prj_...
# SANDBOX_IMAGE=...                    (optional; default vercel/sandbox/universal)
# STRIPE_SECRET_KEY=sk_test_...        (later: payments)
# STRIPE_WEBHOOK_SECRET=whsec_...      (later: payments)
